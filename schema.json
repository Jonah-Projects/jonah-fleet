{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JonahFleetManifest",
  "description": "Configuration manifest for Jonah Fleet autonomous agents",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "The pinned fleet version or semver range"
    },
    "preset": {
      "type": "string",
      "enum": ["minimal", "standard", "full", "custom"],
      "default": "standard",
      "description": "Selected routine bundle preset"
    },
    "routines": {
      "type": "object",
      "properties": {
        "autowork": { "type": "boolean" },
        "peer-review": { "type": "boolean" },
        "optimizer": { "type": "boolean" },
        "issues-housekeeping": { "type": "boolean" },
        "dependency-update-security-check": { "type": "boolean" },
        "product-planning": { "type": "boolean" },
        "analytics-review": { "type": "boolean" },
        "design-review": { "type": "boolean" }
      },
      "additionalProperties": false,
      "description": "Granular routine toggles"
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of core engineering skills to install/sync"
    },
    "models": {
      "type": "object",
      "properties": {
        "default": { "type": "string", "description": "Default model used across routines" },
        "autowork": { "type": "string", "description": "Target model for autowork routine" },
        "peer-review": { "type": "string", "description": "Target model for peer-review routine" },
        "optimizer": { "type": "string", "description": "Target model for optimizer routine" },
        "issues-housekeeping": { "type": "string", "description": "Target model for issues-housekeeping routine" },
        "dependency-update-security-check": { "type": "string", "description": "Target model for dependency-update-security-check routine" },
        "product-planning": { "type": "string", "description": "Target model for product-planning routine" },
        "analytics-review": { "type": "string", "description": "Target model for analytics-review routine" },
        "design-review": { "type": "string", "description": "Target model for design-review routine" }
      },
      "additionalProperties": { "type": "string" },
      "description": "Per-routine model overrides (e.g. gemini-3.7-flash-high, gemini-3.7-flash)"
    },
    "budgets": {
      "type": "object",
      "properties": {
        "weeklyTokens": {
          "type": "number",
          "description": "Weekly token budget limit across routines"
        },
        "maxIterations": {
          "type": "object",
          "properties": {
            "default": { "type": "number" },
            "autowork": { "type": "number" },
            "peer-review": { "type": "number" },
            "optimizer": { "type": "number" },
            "issues-housekeeping": { "type": "number" },
            "dependency-update-security-check": { "type": "number" },
            "product-planning": { "type": "number" },
            "analytics-review": { "type": "number" },
            "design-review": { "type": "number" }
          },
          "additionalProperties": { "type": "number" },
          "description": "Maximum tool call iterations per routine"
        },
        "timeoutMinutes": {
          "type": "object",
          "properties": {
            "default": { "type": "number" },
            "autowork": { "type": "number" },
            "peer-review": { "type": "number" },
            "optimizer": { "type": "number" },
            "issues-housekeeping": { "type": "number" },
            "dependency-update-security-check": { "type": "number" },
            "product-planning": { "type": "number" },
            "analytics-review": { "type": "number" },
            "design-review": { "type": "number" }
          },
          "additionalProperties": { "type": "number" },
          "description": "Workflow runner timeout in minutes per routine"
        }
      },
      "additionalProperties": false,
      "description": "Per-routine token, iteration, and timeout budgets"
    },
    "schedules": {
      "type": "object",
      "properties": {
        "autowork": { "type": "string", "description": "Custom cron schedule for autowork (e.g. '0 * * * *')" },
        "peer-review": { "type": "string", "description": "Custom cron schedule for peer-review watchdog" },
        "optimizer": { "type": "string", "description": "Custom cron schedule for prompt optimizer" },
        "issues-housekeeping": { "type": "string", "description": "Custom cron schedule for issues housekeeping" },
        "dependency-update-security-check": { "type": "string", "description": "Custom cron schedule for dependency security checks" },
        "analytics-review": { "type": "string", "description": "Custom cron schedule for analytics review" },
        "design-review": { "type": "string", "description": "Custom cron schedule for design review" },
        "sync-fleet": { "type": "string", "description": "Custom cron schedule for fleet sync" }
      },
      "additionalProperties": { "type": "string" },
      "description": "Custom cron schedules per routine or workflow"
    },
    "repositories": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of fleet repositories tracked for multi-repo monitoring"
    },
    "autoUpdate": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "channel": { "type": "string", "enum": ["stable", "latest"], "default": "stable" }
      },
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "endpoint": { "type": "string", "description": "Optional telemetry collector webhook or API endpoint URL" },
        "weeklyTokenBudget": { "type": "number", "default": 8750000, "description": "Global weekly token ceiling across fleet (~8.75M tokens/week)" }
      },
      "additionalProperties": false
    },
    "dualExecution": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true, "description": "Enable priority-driven dual local/cloud execution" },
        "cloudPriorities": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["P0", "P1"],
          "description": "Priorities handled immediately by cloud GitHub Actions"
        },
        "cloudCatchupHours": {
          "type": "number",
          "default": 48,
          "description": "Hours before lower-priority items are eligible for cloud catchup"
        }
      },
      "additionalProperties": false,
      "description": "Configuration for priority-driven dual local/cloud agent execution"
    },
    "labels": {
      "type": "object",
      "properties": {
        "protected": {
          "type": "array",
          "items": { "type": "string" },
          "description": "User-defined list or wildcard patterns of protected labels retained during label pruning"
        }
      },
      "additionalProperties": false,
      "description": "Configuration for label management and protection shields"
    }
  },
  "required": ["version", "preset", "routines", "skills"],
  "additionalProperties": false
}
